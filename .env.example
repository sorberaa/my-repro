# OSINT Lab Configuration Example
# Copy this file to config/.env and fill in your values

# ================== Telegram Bot ==================
# Получить токен: https://t.me/BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш ID в Telegram (узнать: https://t.me/userinfobot)
ADMIN_CHAT_ID=123456789

# ================== Админ панель ==================
# Токен для доступа в админ панель на /admin/visits-html?token=YOUR_ADMIN_TOKEN
ADMIN_TOKEN=your_secure_admin_token_here_change_me

# ================== Хранилище данных ==================
# Папка для хранения логов и данных
DATA_DIR=/app/data

# ================== Cloudflare Tunnel (опционально) ==================
# Токен для подключения через Cloudflare Tunnel
# CF_TUNNEL_TOKEN=ey...

# ================== Домен ==================
# Домен приложения (для Telegram WebApp)
DOMAIN=https://osint.qrport.eu

# ================== Логирование ==================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ================== Образовательная цель ==================
# Это приложение предназначено в образовательных целях ONLY!
# Не используйте против людей без согласия
EDUCATIONAL_PURPOSE=true
